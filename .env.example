# 监听端口
PORT=8080

# 数据目录（数据库、主密钥、附件缓存）。Docker 内为 /data
DATA_DIR=./data

# 32 字节 hex 主密钥。留空则读取 DATA_DIR/master.key，不存在时自动生成（务必备份）
MASTER_KEY=

# 用户实际访问的完整地址，OAuth 回调需要与之一致
BASE_URL=http://localhost:8080

# 首次启动自动创建登录用户；留空则通过 /setup 页面创建
INIT_USERNAME=
INIT_PASSWORD=

# 会话有效期（天）
SESSION_TTL_DAYS=30

# 日志级别：trace | debug | info | warn | error
LOG_LEVEL=info

# 时区
TZ=Asia/Shanghai

# 出站代理（可选）。服务器在国内时 Google 的令牌接口与 imap.gmail.com 需要走代理。
# 支持 http://host:port 与 socks5://host:port（socks 仅对 IMAP 生效，OAuth 请用 http 代理）
PROXY_URL=
# 哪些服务商走代理，逗号分隔：gmail | outlook | qq | netease | custom。默认 gmail
PROXY_FOR=gmail
