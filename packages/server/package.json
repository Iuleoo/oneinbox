{
  "name": "@inbox/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsup",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:generate:custom": "drizzle-kit generate --custom"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "^10.1.4",
    "@inbox/shared": "workspace:*",
    "argon2": "^0.41.1",
    "better-sqlite3": "^12.2.0",
    "dotenv": "^16.4.5",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.12.5",
    "fastify-plugin": "^5.1.0",
    "iconv-lite": "^0.6.3",
    "imapflow": "^1.0.191",
    "isomorphic-dompurify": "^2.19.0",
    "mailparser": "^3.7.2",
    "pino": "^9.6.0",
    "undici": "^6.28.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/mailparser": "^3.4.5",
    "@types/node": "^22.10.2",
    "drizzle-kit": "^0.30.1",
    "pino-pretty": "^13.0.0",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
